# Secret for /api/waterway/refresh (required for the external cron on Plesk).
CRON_SECRET=change-me-to-a-long-random-string

# Set to "off" when an external scheduler (Plesk cron) drives the refresh,
# so the in-process node-cron is not started as well.
INTERNAL_CRON=off

# Where snapshots and 24h history are stored. Use an absolute path outside the
# build folder so redeploys keep the history (default: ./data/snapshots).
# DATA_DIR=/var/www/vhosts/example.com/waterway-data

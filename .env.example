# Secret for /api/waterway/refresh (required for the external cron on Plesk).
CRON_SECRET=change-me-to-a-long-random-string

# Set to "off" when an external scheduler (Plesk cron) drives the refresh,
# so the in-process node-cron is not started as well.
INTERNAL_CRON=off

# Where snapshots and 24h history are stored. Both server.js (repo root) and
# .next/standalone/server.js already default this to <project>/data/snapshots,
# which survives rebuilds — set DATA_DIR here only if you want it somewhere
# else, or if you deploy .next/standalone copied out on its own (not inside
# the built project), where the auto-anchor can't find the real project root.
# Note: Next does NOT copy .env files into .next/standalone, so if you rely on
# this file rather than setting DATA_DIR as a real process env var, it must be
# read from the project root — i.e. only when starting via the repo-root
# server.js, not .next/standalone/server.js directly.
# DATA_DIR=/var/www/vhosts/example.com/waterway-data
